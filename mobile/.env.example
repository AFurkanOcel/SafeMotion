# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000

# iOS simulator or local web:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Physical phone on the same Wi-Fi network:
# Replace PC_LOCAL_IP with your computer's LAN IP address, for example 192.168.0.12.
EXPO_PUBLIC_API_BASE_URL=http://PC_LOCAL_IP:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://PC_LOCAL_IP:3000
