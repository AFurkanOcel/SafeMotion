{
  "expo": {
    "name": "SafeMotion",
    "slug": "safemotion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/safemotion.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safemotion.mobile"
    },
    "android": {
      "package": "com.safemotion.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/safemotion.png",
        "backgroundColor": "#0b1f3a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api/v1",
      "socketUrl": "http://localhost:3000"
    }
  }
}
